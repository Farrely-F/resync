# Environment contract for resync. Copy to `.env.local` and adjust.
#
# PROVIDER AND MODEL
#   AI_PROVIDER  openrouter | groq | fireworks. Optional: when unset, the
#                first provider that has a key leads, in the order groq >
#                openrouter > fireworks, and the other keys follow
#                in that order as fallbacks. Model ids stay vendor-shaped in MODEL_ID, but which
#                vendor they are sent to is this setting, not part of the name.
#   MODEL_ID     Optional. Defaults to the chosen provider's own default:
#                  openrouter -> openrouter/free
#                  groq       -> openai/gpt-oss-120b
#                  fireworks  -> accounts/fireworks/models/gpt-oss-120b
#   Keys         OPENROUTER_API_KEY / GROQ_API_KEY / FIREWORKS_API_KEY. Server-side only; never sent
#                to the browser. With both keys configured, the other provider is
#                used automatically when the first cannot route the request, or
#                when its free allowance is spent — that is the point of having two.
#
# AI_MODE
#   live  Calls the configured provider.
#   mock  Every AI call is served from a fixture recorded by the feature that
#         makes the call: no network, no key, fully deterministic.
#
# Which mode applies, in order:
#   1. an explicit AI_MODE here always wins;
#   2. otherwise any non-empty API key means live — a configured key is treated as
#      a request to use it, never as something to ignore quietly;
#   3. otherwise production means live, and fails loudly without a key;
#   4. otherwise mock, so a fresh clone runs with no setup.
#
# If a run is answering from fixtures, the app says so in a banner at the top of
# every page: mock mode replaces your own resume and posting with stored samples,
# so it must never look like a successful parse.
AI_MODE=

# Optional. Ordered models tried when the provider cannot route the primary one.
# A bare id belongs to the primary provider; `provider@model` targets the other
# one, e.g. groq@openai/gpt-oss-20b. Blank keeps the built-in default list.
# `@` is the separator because model ids already contain `:` (openrouter's
# `:free` variants) and `/` (vendor prefixes). Listing only the configured model
# leaves nothing to fall back to; setting this replaces the default list exactly.
FALLBACK_MODEL_IDS=

OPENROUTER_API_KEY=
GROQ_API_KEY=
FIREWORKS_API_KEY=

# DEPLOYMENT
#   /api/documents declares `maxDuration = 60`, because a long document can take
#   longer than a platform's default function timeout — and a function cut off
#   mid-answer looks exactly like a provider that never replied. The seam's own
#   budget for those tasks is 60 s (src/lib/documents/service.ts), shared between
#   the models that could answer; the browser waits 75 s, so the server's answer
#   normally wins.

# LOGGING
#   LOG_LEVEL  debug | info | warn | error. Defaults to info; an unrecognised
#              value also means info, because a typo must not silence the log that
#              would have explained the problem.
#   Every event is one JSON line: `warn` and `error` go to stderr, the rest to
#   stdout. `debug` adds each attempt, each scheduled retry and each model that was
#   skipped. No line contains a credential, and none contains the prompt — on these
#   paths the prompt is the reader's resume text.
LOG_LEVEL=

# SITE ADDRESS
#   NEXT_PUBLIC_SITE_URL  The public origin, e.g. https://resync.example. It is the
#                         base of every absolute URL in link previews (the Open Graph
#                         image), the canonical tag, the sitemap and robots.txt. On
#                         Vercel, VERCEL_PROJECT_PRODUCTION_URL is used when this is
#                         empty; with neither, localhost, which is right for
#                         development and wrong for a deployment.
NEXT_PUBLIC_SITE_URL=

# Free-tier allowances are per key and shared:
#   OpenRouter  20 requests/minute, 50 requests/day below $10 of credits (1000/day above)
#   Groq        per-model limits, listed in their console
#   Fireworks   per-account rate limits, listed in their console

# Where the browser downloads the ~128 MB TeX engine from. Leave empty to serve it
# from this app's own /core/busytex (run `npm run fetch:tex` locally). On Vercel,
# upload that folder to a public bucket (e.g. Cloudflare R2) and put its URL here;
# the bucket needs a CORS rule allowing GET from your app's origin.
NEXT_PUBLIC_TEX_ASSETS_URL=
