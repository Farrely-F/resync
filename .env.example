# Environment contract for resync. Copy to `.env.local` and adjust.
#
# AI_MODE
#   live  Calls OpenRouter using OPENROUTER_API_KEY.
#   mock  Every AI call is served from a fixture recorded by the feature that
#         makes the call: no network, no key, fully deterministic.
#
# Which one applies, in order:
#   1. an explicit AI_MODE here always wins;
#   2. otherwise a non-empty OPENROUTER_API_KEY means live — a configured key is
#      treated as a request to use it, never as something to ignore quietly;
#   3. otherwise production means live, and fails loudly without a key;
#   4. otherwise mock, so a fresh clone runs with no setup.
#
# If a run is answering from fixtures, the app says so in a banner at the top of
# every page: mock mode replaces your own resume and posting with stored samples,
# so it must never look like a successful parse.
AI_MODE=live

# Required for live mode. Server-side only: it is never sent to the browser.
OPENROUTER_API_KEY=

# Model identifier sent to OpenRouter. The default is the free auto-router.
# Free-tier limits are shared across everyone using the same key:
#   20 requests/minute, and 50 requests/day below $10 of credits (1000/day above).
OPENROUTER_MODEL=openrouter/free

# Ordered fallback models, tried in order when the provider cannot route the
# primary model (HTTP 503). Comma-separated; blank falls back to the built-in list.
OPENROUTER_FALLBACK_MODELS=
