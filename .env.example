# Environment contract. Copy to `.env.local` — `cp .env.example .env.local`.
#
# AI_MODE=mock serves every model call from a recording the feature ships with:
# no network, no API key, fully deterministic. Outside production that is the
# default, so a fresh clone runs immediately. AI_MODE=live calls OpenRouter with
# the key below, and requires OPENROUTER_API_KEY.
AI_MODE=mock

# Server-side OpenRouter key. Never expose it to the browser; every model call is
# made from a route handler. Required when AI_MODE=live.
OPENROUTER_API_KEY=

# The model an analysis asks for. `openrouter/free` is an auto-router: it picks a
# free model that fits the request, and may pick a different one per request, so
# the same input can produce different output. Anything user-visible must not
# depend on model determinism.
OPENROUTER_MODEL=openrouter/free

# Comma-separated, tried in order when the provider answers 503 "no available
# model provider meets your routing requirements". That answer means routing
# failed, not that the request was wrong, so the same request is sent to a named
# model instead of the router. Leave blank for the built-in free list
# (qwen/qwen3.8-27b:free, nvidia/nemotron-3-super-120b-a12b:free,
# dots-studio/dots-3-note-preview:free), or list only OPENROUTER_MODEL to have
# no fallbacks. Every entry must support structured output, which every call in
# this app asks for.
OPENROUTER_FALLBACK_MODELS=

# Measured behaviour of the free tier this app is built against, which is what
# the retry and fallback logic exists for:
#   - 20 requests per minute, shared by everyone using the same key.
#   - 50 requests per day while the account holds under $10 of credit, and 1000
#     per day above it.
#   - A 429 may carry `Retry-After`, which is honoured; retries are bounded, so a
#     request always ends with an answer for the user rather than spinning.
#   - A 503 usually means no free model could be routed, which is what
#     OPENROUTER_FALLBACK_MODELS is for.
